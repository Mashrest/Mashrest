{
  "name": "file",
  "version": "0.1.0",
  "author": "Mashrest",
  "description": "Standard library for work with files.",
  "requires": {
    "mashrest_v": "0.1.0",
    "abi": 3
  },
  "functions": {
    "exists": {
      "internal_name": "exists",
      "description": {
        "en": "Checks if a file exists.",
        "ru": "Проверяет, существует ли файл."
      },
      "args": [
        { "name": "path", "type": "string", "required": true }
      ],
      "returns": "boolean"
    },

    "read": {
      "internal_name": "readf",
      "description": {
        "en": "Reads the contents of a file.",
        "ru": "Читает содержимое файла."
      },
      "args": [
        { "name": "path", "type": "string", "required": true }
      ],
      "returns": "string"
    },

    "readlines": {
      "internal_name": "readlines",
      "description": {
        "en": "Reads lines from a file.",
        "ru": "Читает строки из файла."
      },
      "args": [
        { "name": "path", "type": "string", "required": true },
        { "name": "mode", "type": "string", "required": true }
      ],
      "returns": "array"
    },

    "write": {
      "internal_name": "writetofile",
      "description": {
        "en": "Writes data to a file.",
        "ru": "Записывает данные в файл."
      },
      "args": [
        { "name": "path", "type": "string", "required": true },
        { "name": "data", "type": "string", "required": true }
      ],
      "returns": "boolean"
    },

    "append": {
      "internal_name": "append",
      "description": {
        "en": "Appends data to a file.",
        "ru": "Дописывает данные в конец файла."
      },
      "args": [
        { "name": "path", "type": "string", "required": true },
        { "name": "data", "type": "string", "required": true }
      ],
      "returns": "boolean"
    }
  }
}