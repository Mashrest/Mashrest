{
  "name": "math",
  "version": "0.1.0",
  "author": "Mashrest",
  "description": "Standard math library.",
  "requires": {
    "mashrest_v": "0.1.3",
    "abi": 3
  },
  "functions": {
    "square": {
      "internal_name": "msrest_square",
      "description": "Returns the square of a number.",
      "example": "m::square(5) -> 25",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "numeric"
    },

    "sqroot": {
      "internal_name": "msrest_sqroot",
      "description": "Returns the square root of a number.",
      "example": "m::sqroot(16) -> 4",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "float|integer"
    },

    "const_exp": {
      "internal_name": "msrest_const_exp",
      "description": "Returns e with the given precision.",
      "example": "m::const_exp(5) -> 2.71828",
      "args": [
        { "name": "precision", "type": "integer", "required": false, "default": 5 }
      ],
      "returns": "float"
    },

    "const_pi": {
      "internal_name": "msrest_const_pi",
      "description": "Returns the value of pi with the given precision.",
      "example": "m::const_pi(5) -> 3.14159",
      "args": [
        { "name": "precision", "type": "integer", "required": false, "default": 5 }
      ],
      "returns": "float"
    },

    "exp": {
      "internal_name": "msrest_exp",
      "description": "Returns e raised to the power x.",
      "example": "m::exp(2) -> 7.389056099...",
      "args": [
        { "name": "x", "type": "numeric", "required": true }
      ],
      "returns": "float"
    },

    "sin": {
      "internal_name": "msrest_sinus",
      "description": "Returns the sine of a number.",
      "example": "m::sin(45) -> 0.707107...",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "float"
    },

    "cos": {
      "internal_name": "msrest_cosin",
      "description": "Returns the cosine of a number.",
      "example": "m::cos(0) -> 1",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "float"
    },

    "power": {
      "internal_name": "msrest_power",
      "description": "Raises a number to the given power. Always returns a float.",
      "example": "m::power(2, 10) -> 1024",
      "args": [
        { "name": "base", "type": "numeric", "required": true },
        { "name": "exponent", "type": "numeric", "required": true }
      ],
      "returns": "float|integer"
    },

    "min": {
      "internal_name": "msrest_min",
      "description": "Finds the minimum of two numbers. Returns integer if both are integers, otherwise float.",
      "example": "m::min(2, 10) -> 2",
      "args": [
        { "name": "first", "type": "numeric", "required": true },
        { "name": "second", "type": "numeric", "required": true }
      ],
      "returns": "float|integer"
    },

    "max": {
      "internal_name": "msrest_max",
      "description": "Finds the maximum of two numbers. Returns integer if both are integers, otherwise float.",
      "example": "m::max(7, 10) -> 10",
      "args": [
        { "name": "first", "type": "numeric", "required": true },
        { "name": "second", "type": "numeric", "required": true }
      ],
      "returns": "float|integer"
    },

    "clamp": {
      "internal_name": "msrest_clamp",
      "description": "Clamps a number into the [min, max] range.",
      "example": "m::clamp(10, 30, 100) -> 30",
      "args": [
        { "name": "min", "type": "numeric", "required": true },
        { "name": "number", "type": "numeric", "required": true },
        { "name": "max", "type": "numeric", "required": true }
      ],
      "returns": "float|integer"
    },

    "abs": {
      "internal_name": "msrest_abs",
      "description": "Returns the absolute value of a number.",
      "example": "m::abs(-39) -> 39",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "float|integer"
    },

    "round": {
      "internal_name": "msrest_round",
      "description": "Rounds a number to the nearest integer. Integer input is returned unchanged.",
      "example": "m::round(3.7) -> 4.0",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "numeric"
    },

    "floor": {
      "internal_name": "msrest_floor",
      "description": "Rounds a number down toward negative infinity. Integer input is returned unchanged.",
      "example": "m::floor(-10.1) -> -11.0",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "numeric"
    },

    "ceil": {
      "internal_name": "msrest_ceil",
      "description": "Rounds a number up toward positive infinity. Integer input is returned unchanged.",
      "example": "m::ceil(-10.1) -> -10.0",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "numeric"
    },


    "trunc": {
      "internal_name": "msrest_trunc",
      "description": "Truncates a number toward zero (drops the fractional part). Integer input is returned unchanged.",
      "example": "m::trunc(-10.9) -> -10.0",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "numeric"
    },

    "sign": {
      "internal_name": "msrest_sign",
      "description": "Returns the sign of a number: -1 if negative, 0 if zero, 1 if positive.",
      "example": "m::sign(-39) -> -1",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "integer"
    },

    "is_even": {
      "internal_name": "msrest_is_even",
      "description": "Returns true if the integer is even, false otherwise.",
      "example": "m::is_even(4) -> <1>",
      "args": [
        { "name": "n", "type": "integer", "required": true }
      ],
      "returns": "bool"
    },

    "is_odd": {
      "internal_name": "msrest_is_odd",
      "description": "Returns true if the integer is odd, false otherwise.",
      "example": "m::is_odd(3) -> <1>",
      "args": [
        { "name": "n", "type": "integer", "required": true }
      ],
      "returns": "bool"
    },

    "fmod": {
      "internal_name": "msrest_fmod",
      "description": "Returns the floating-point remainder of a/b. The result has the same sign as the dividend.",
      "example": "m::fmod(10.5, 3) -> 1.5",
      "args": [
        { "name": "a", "type": "numeric", "required": true },
        { "name": "b", "type": "numeric", "required": true }
      ],
      "returns": "float"
    },

    "frac": {
      "internal_name": "msrest_frac",
      "description": "Returns the fractional part of a number, always in [0, 1). Returns 0 for integers.",
      "example": "m::frac(-3.7) -> 0.3",
      "args": [
        { "name": "value", "type": "numeric", "required": true }
      ],
      "returns": "float"
    },

    "factorial": {
      "internal_name": "msrest_factorial",
      "description": "Returns the factorial of a non-negative integer (max 20).",
      "example": "m::factorial(5) -> 120",
      "args": [
        { "name": "n", "type": "integer", "required": true }
      ],
      "returns": "integer"
    },

    "sum_progression": {
      "internal_name": "msrest_sum_progression",
      "description": "Returns the sum of an arithmetic progression: n terms starting at 'start' with step 'step' (optional, default = 1).",
      "example": "m::sum_progression(1, 1, 100) -> 5050",
      "args": [
        { "name": "start", "type": "integer", "required": true },
        { "name": "step", "type": "integer", "required": false, "default": 1 },
        { "name": "n", "type": "integer", "required": true }
      ],
      "returns": "integer"
    },

    "to_radians": {
      "internal_name": "msrest_to_radians",
      "description": "Converts an angle from degrees to radians.",
      "example": "m::to_radians(180) -> 3.141592653589793",
      "args": [
        { "name": "degrees", "type": "numeric", "required": true }
      ],
      "returns": "float"
    },

    "to_degrees": {
      "internal_name": "msrest_to_degrees",
      "description": "Converts an angle from radians to degrees.",
      "example": "m::to_degrees(3.141592653589793) -> 180.0",
      "args": [
        { "name": "radians", "type": "numeric", "required": true }
      ],
      "returns": "float"
    }

  }
}